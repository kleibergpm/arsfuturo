generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Rol { ADMINISTRADOR AGENTE SUPERVISOR }
enum EstadoAfiliado { ACTIVO SUSPENDIDO INACTIVO }
enum EstadoAutorizacion { PENDIENTE APROBADA RECHAZADA }
enum EstadoReclamo { EN_REVISION APROBADA RECHAZADA }
enum EstadoPoliza { VIGENTE EN_GRACIA SUSPENDIDA VENCIDA }
enum EstadoFactura { PENDIENTE PAGADA ATRASADA EN_GRACIA }
enum EstadoServicio { PENDIENTE_PAGO PAGADO }
enum EstadoPago { PROCESADO RECHAZADO }

model Usuario {
  id String @id @default(uuid())
  usuario String @unique
  nombre String
  passwordHash String
  rol Rol
  notificaciones Notificacion[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Plan {
  id String @id
  nombre String
  copagoConsulta Decimal @db.Decimal(12,2)
  cobertura Json
  afiliados Afiliado[]
  polizas Poliza[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Proveedor {
  id String @id @default(uuid())
  nombre String
  tipo String
  ciudad String
  telefono String
  autorizaciones Autorizacion[]
  reclamos Reclamo[]
  servicios ServicioMedico[]
  pagos PagoProveedor[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ciudad, tipo])
}
model Poliza {
  id String @id
  empresa String
  planId String
  desde DateTime @db.Date
  hasta DateTime @db.Date
  primaMensual Decimal @db.Decimal(14,2)
  asegurados Int @default(0)
  estado EstadoPoliza @default(VIGENTE)
  plan Plan @relation(fields: [planId], references: [id])
  afiliados Afiliado[]
  facturas Factura[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([estado])
}
model Afiliado {
  id String @id @default(uuid())
  nombre String
  cedula String @unique
  planId String
  polizaId String?
  estado EstadoAfiliado @default(ACTIVO)
  desde DateTime @db.Date
  nacimiento DateTime? @db.Date
  telefono String?
  correo String?
  dependientes Int @default(0)
  plan Plan @relation(fields: [planId], references: [id])
  poliza Poliza? @relation(fields: [polizaId], references: [id])
  autorizaciones Autorizacion[]
  reclamos Reclamo[]
  servicios ServicioMedico[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([estado])
}
model Autorizacion {
  id String @id @default(uuid())
  afiliadoId String
  proveedorId String
  procedimiento String
  copago Decimal @db.Decimal(12,2)
  estado EstadoAutorizacion @default(PENDIENTE)
  fecha DateTime @default(now()) @db.Date
  afiliado Afiliado @relation(fields: [afiliadoId], references: [id])
  proveedor Proveedor @relation(fields: [proveedorId], references: [id])
  servicios ServicioMedico[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([estado, fecha])
}
model Reclamo {
  id String @id @default(uuid())
  afiliadoId String
  proveedorId String
  monto Decimal @db.Decimal(14,2)
  estado EstadoReclamo @default(EN_REVISION)
  fecha DateTime @default(now()) @db.Date
  afiliado Afiliado @relation(fields: [afiliadoId], references: [id])
  proveedor Proveedor @relation(fields: [proveedorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([estado, fecha])
}
model ServicioMedico {
  id String @id @default(uuid())
  afiliadoId String
  proveedorId String
  autorizacionId String?
  descripcion String
  costo Decimal @db.Decimal(14,2)
  copago Decimal @db.Decimal(12,2)
  fecha DateTime @default(now()) @db.Date
  estado EstadoServicio @default(PENDIENTE_PAGO)
  afiliado Afiliado @relation(fields: [afiliadoId], references: [id])
  proveedor Proveedor @relation(fields: [proveedorId], references: [id])
  autorizacion Autorizacion? @relation(fields: [autorizacionId], references: [id])
  pago PagoProveedor?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([estado, fecha])
}
model PagoProveedor {
  id String @id @default(uuid())
  proveedorId String
  servicioId String @unique
  referenciaBanco String @unique
  monto Decimal @db.Decimal(14,2)
  metodo String
  fecha DateTime @default(now()) @db.Date
  estado EstadoPago @default(PROCESADO)
  proveedor Proveedor @relation(fields: [proveedorId], references: [id])
  servicio ServicioMedico @relation(fields: [servicioId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Factura {
  id String @id @default(uuid())
  polizaId String
  periodo String
  emision DateTime @db.Date
  vencimiento DateTime @db.Date
  monto Decimal @db.Decimal(14,2)
  estado EstadoFactura @default(PENDIENTE)
  fechaPago DateTime? @db.Date
  referencia String? @unique
  recordatorioEnviado Boolean @default(false)
  poliza Poliza @relation(fields: [polizaId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([polizaId, periodo])
  @@index([estado, vencimiento])
}
model Notificacion {
  id String @id @default(uuid())
  usuarioId String?
  tipo String
  titulo String?
  mensaje String
  leida Boolean @default(false)
  usuario Usuario? @relation(fields: [usuarioId], references: [id])
  createdAt DateTime @default(now())
  @@index([usuarioId, leida])
}
